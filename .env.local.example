# --- Randevu resim yükleme (Hostinger FTP) ---
# Hepsi SUNUCU GİZLİSİDİR — repoya/sohbete koyma, sadece .env.local'e (ve Vercel proje ayarlarına) yaz.
HOSTINGER_FTP_HOST=
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
HOSTINGER_FTP_PORT=21
# Yüklenen dosyaların yazılacağı klasör (FTP'de göreceğin yol), ör: /public_html/rite-uploads
